# Dependencies
node_modules/

# Environment variables - NEVER commit these, they hold API keys.
# The .env.example files ARE committed; they are templates with no real values.
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
client/.env
client/.env.*
!client/.env.example

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temp files
*.tmp
.cache/

# Local SQLite database (dev only)
server/db/*.sqlite
server/db/*.sqlite-shm
server/db/*.sqlite-wal

# Uploaded files (local storage)
server/uploads/

# Embedded PostgreSQL data and local backups (never commit a database)
server/db/pgdata/
server/db/pgdata.lock
server/backups/
server/db/*.sqlite.imported-*
# Every throwaway database a test or a probe makes. Matched by prefix so a
# new test file inventing its own folder name is ignored too - the first one
# that did got committed.
server/db/test-*pgdata*/
server/db/test-*pgdata*.lock
server/db/scratch-*/
server/db/scratch-*.lock

# Output from the graphify tool.
graphify-out/
