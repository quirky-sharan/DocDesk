# Copy this file to server/.env and fill in what you need.
# DocDesk runs without any of it - every line here is optional.
#
#   cp server/.env.example server/.env
#
# .env is gitignored. Never commit it.


# ─── AI assistant (Ask DocDesk / Ctrl+J on any page) ────────────────────────
#
# Without a key, only simple phrasings work ("sort by price", "add a column
# for expiry date"). With one, it understands the rest.
#
# RECOMMENDED: Groq. Free, no card, and the fastest of the options.
#   1. Go to https://console.groq.com/keys
#   2. Sign in with Google or GitHub
#   3. "Create API Key", give it any name, copy it
#   4. Paste it below and restart the server
#
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Alternatives - set ONE of these instead. See REQUIREMENTS.md for limits.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx      # https://openrouter.ai/keys
# TOGETHER_API_KEY=xxxxxxxx                 # https://api.together.ai/settings/api-keys

# Only needed to override the automatic choice.
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b         # normally leave unset - chosen automatically

# For a local model (Ollama, llama.cpp). No key needed.
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1


# ─── Database ──────────────────────────────────────────────────────────────
#
# Leave DATABASE_URL unset for normal use - DocDesk then runs PostgreSQL embedded,
# with its data in server/db/pgdata, and needs no setup at all.
# Set it only when deploying (UTF8 database, PostgreSQL 14+). See REQUIREMENTS.md.
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL=off                          # only for a local Postgres with no TLS
# DB_POOL_MAX=10
# PGDATA_DIR=./db/pgdata                    # embedded engine's data folder

# Changing the database from the Database page (SQL "Allow changes", restore,
# maintenance). On by default for the embedded engine, off for a hosted one -
# a deployed DocDesk has no sign-in yet.
# DB_ADMIN=on
# SQL_CONSOLE_TIMEOUT_MS=15000

# Daily automatic backups (on by default for the embedded engine).
# AUTO_BACKUP=on
# BACKUP_DIR=./backups


# ─── Other ─────────────────────────────────────────────────────────────────
# PORT=5000
# MAX_UPLOAD_MB=25
# UPLOAD_DIR=./uploads
# CORS_ORIGIN=https://your-frontend.example  # set this when deploying
# SQLITE_PATH=./db/docdesk.sqlite            # an old SQLite file here is imported once, then renamed
