# Copy to .env only if you need to override a default. DocDesk runs without it.

# Leave DATABASE_URL unset for local development - DocDesk then uses a SQLite
# file in server/db/ and needs no setup at all. Set it only when deploying to a
# managed Postgres. See REQUIREMENTS.md for free-tier options.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "off" only for a local Postgres with no TLS.
# DATABASE_SSL=off

# Where the SQLite file lives. Defaults to server/db/docdesk.sqlite.
# SQLITE_PATH=./db/docdesk.sqlite

# PORT=5000

# Restrict which origin may call the API. Defaults to allowing any, which is
# fine locally. Set this when deploying.
# CORS_ORIGIN=https://your-frontend.example
